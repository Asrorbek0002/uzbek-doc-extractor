# ── SAMPLE FILE ────────────────────────────────────────────────────────────
# Copy it to `.env`:
#     cp .env.example .env
#
# There are no SECRETS in this project — everything runs locally and no
# external API is ever called. This file is configuration only; the project
# also works without a `.env` at all.

# ── OCR (Tesseract) ───────────────────────────────────────────────────────
# The Tesseract language pack. `uzb` is Uzbek (Latin). Install with:
#     sudo apt install -y tesseract-ocr tesseract-ocr-uzb poppler-utils
# If the language pack is unavailable, fall back to `eng` (the Latin alphabet
# is still read, at lower quality).
OCR_TIL=uzb

# Render density. 300 dpi is the standard for OCR. Lowering it is faster but
# costs accuracy.
OCR_DPI=300
